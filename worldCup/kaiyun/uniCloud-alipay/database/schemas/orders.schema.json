{
  "bsonType": "object",
  "required": ["orderNo", "userId", "matchId", "betAmount", "totalOdds"],
  "properties": {
    "_id": { "bsonType": "string" },
    "orderNo": {
      "bsonType": "string",
      "title": "订单编号",
      "description": "唯一订单号"
    },
    "userId": {
      "bsonType": "string",
      "title": "用户ID",
      "foreignKey": "users._id"
    },
    "matchId": {
      "bsonType": "string",
      "title": "赛事ID",
      "foreignKey": "matches._id"
    },
    "betAmount": {
      "bsonType": "double",
      "title": "下注金额",
      "minimum": 0
    },
    "totalOdds": {
      "bsonType": "double",
      "title": "总赔率",
      "description": "串关时 = 各玩法赔率乘积；单玩 = 该玩法赔率"
    },
    "winAmount": {
      "bsonType": "double",
      "title": "中奖金额",
      "description": "下注额 * 总赔率（中奖时计算）",
      "default": 0
    },
    "status": {
      "bsonType": "string",
      "title": "订单状态",
      "enum": ["pending", "won", "lost", "settled", "refunded"],
      "description": "待开奖->已中奖/未中奖->已结算；refunded=赛事取消退款",
      "default": "pending"
    },
    "result": {
      "bsonType": "string",
      "title": "结算结果",
      "enum": ["won", "lost", "partial"],
      "description": "won=返还≥本金；partial=0<返还<本金(半赢半输)；lost=返还0"
    },
    "isParlay": {
      "bsonType": "bool",
      "title": "是否串关",
      "default": false
    },
    "agentId": {
      "bsonType": "string",
      "title": "下单时归属代理ID",
      "description": "下单时快照，null 表示无代理；用户转移代理后历史订单不变"
    },
    "agentRate": {
      "bsonType": "double",
      "title": "下单时佣金比例(%)",
      "description": "下单时快照，后续调整代理比例不影响本单"
    },
    "commissionStatus": {
      "bsonType": "string",
      "title": "佣金状态",
      "enum": ["none", "pending", "available", "paid", "void", "skipped"],
      "default": "none",
      "description": "none=未处理；pending=待确认；available=可结算；paid=已支付；void=已冲销；skipped=不参与"
    },
    "commissionAmount": {
      "bsonType": "double",
      "title": "本单佣金",
      "default": 0
    },
    "commissionRecordId": {
      "bsonType": "string",
      "title": "关联佣金记录ID"
    },
    "commissionTime": {
      "bsonType": "date",
      "title": "佣金处理时间"
    },
    "deleted": {
      "bsonType": "bool",
      "title": "逻辑删除",
      "description": "true表示已删除，管理端和移动端均不可见",
      "default": false
    },
    "createTime": { "bsonType": "date", "title": "下单时间" },
    "settleTime": { "bsonType": "date", "title": "结算时间" }
  }
}
