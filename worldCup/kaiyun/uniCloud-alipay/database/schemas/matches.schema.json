{
  "bsonType": "object",
  "required": ["teamA", "teamB", "startTime"],
  "properties": {
    "_id": { "bsonType": "string" },
    "name": {
      "bsonType": "string",
      "title": "赛事名称",
      "description": "同步赛事为竞彩场次+联赛名，如: 周日022 西甲"
    },
    "teamA": { "bsonType": "string", "title": "主队名称" },
    "teamB": { "bsonType": "string", "title": "客队名称" },
    "teamAFlag": { "bsonType": "string", "title": "主队队徽图片URL" },
    "teamBFlag": { "bsonType": "string", "title": "客队队徽图片URL" },
    "startTime": {
      "bsonType": "date",
      "title": "开始时间",
      "description": "赛事开始时间，也是下注截止时间"
    },
    "status": {
      "bsonType": "string",
      "title": "赛事状态",
      "enum": ["upcoming", "live", "finished", "settled", "cancelled"],
      "description": "未开始->进行中->已结束->已结算；cancelled=赛事取消(退款)",
      "default": "upcoming"
    },
    "online": {
      "bsonType": "bool",
      "title": "是否上架",
      "description": "同步赛事默认true自动上架，管理端可手动下架/上架",
      "default": true
    },
    "deleted": {
      "bsonType": "bool",
      "title": "逻辑删除标记",
      "default": false
    },
    "sourceMatchId": {
      "bsonType": "string",
      "title": "vipc赛事ID",
      "description": "接口matchId，同步upsert去重依据"
    },
    "jingcaiId": { "bsonType": "string", "title": "竞彩编号", "description": "如202608167022" },
    "ccId": { "bsonType": "string", "title": "竞彩场次号", "description": "如周日022" },
    "leagueName": { "bsonType": "string", "title": "联赛名称" },
    "leagueId": { "bsonType": "int", "title": "联赛ID" },
    "homeRank": { "bsonType": "string", "title": "主队排名" },
    "guestRank": { "bsonType": "string", "title": "客队排名" },
    "season": { "bsonType": "string", "title": "赛季" },
    "round": { "bsonType": "string", "title": "轮次" },
    "homeScore": { "bsonType": "int", "title": "主队全场比分" },
    "guestScore": { "bsonType": "int", "title": "客队全场比分" },
    "homeHalfScore": { "bsonType": "int", "title": "主队半场比分" },
    "guestHalfScore": { "bsonType": "int", "title": "客队半场比分" },
    "homeOtScore": { "bsonType": "int", "title": "主队加时进球(竞彩结算需扣除)" },
    "guestOtScore": { "bsonType": "int", "title": "客队加时进球(竞彩结算需扣除)" },
    "homeOtPenalty": { "bsonType": "int", "title": "主队点球进球(竞彩结算需扣除)" },
    "guestOtPenalty": { "bsonType": "int", "title": "客队点球进球(竞彩结算需扣除)" },
    "displayState": { "bsonType": "string", "title": "接口比赛状态文字", "description": "未开始/进行中/完场/推迟/取消" },
    "time": { "bsonType": "string", "title": "进行中时间", "description": "如67'" },
    "description": {
      "bsonType": "string",
      "title": "单关标志描述",
      "description": "含\"单关\"表示该场胜平负可单关投注"
    },
    "syncedAt": { "bsonType": "date", "title": "数据同步时间", "description": "用于数据更新时间展示与过期检测" },
    "settledAt": { "bsonType": "date", "title": "结算时间" },
    "createTime": { "bsonType": "date" },
    "updateTime": { "bsonType": "date" },
    "oddsVersion": {
      "bsonType": "int",
      "title": "赔率版本号",
      "description": "每次该比赛下任意玩法赔率变更时 +1，用于移动端轮询自动刷新",
      "default": 0
    }
  }
}
