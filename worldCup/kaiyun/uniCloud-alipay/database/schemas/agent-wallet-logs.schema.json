{
  "bsonType": "object",
  "required": ["agentId", "type", "amount", "balanceAfter"],
  "properties": {
    "_id": { "bsonType": "string" },
    "agentId": { "bsonType": "string", "title": "代理用户ID", "foreignKey": "users._id" },
    "type": {
      "bsonType": "string",
      "title": "流水类型",
      "enum": ["commission", "paid", "adjust"],
      "description": "commission=佣金确认入账；paid=线下支付；adjust=调整"
    },
    "amount": { "bsonType": "double", "title": "变动金额", "description": "正数入账，负数出账" },
    "balanceAfter": { "bsonType": "double", "title": "变动后待结算佣金" },
    "recordId": { "bsonType": "string", "title": "佣金记录ID" },
    "settlementId": { "bsonType": "string", "title": "结算批次ID" },
    "remark": { "bsonType": "string", "title": "备注" },
    "operatorId": { "bsonType": "string", "title": "操作人ID" },
    "operatorName": { "bsonType": "string", "title": "操作人名称" },
    "createTime": { "bsonType": "date", "title": "创建时间" }
  }
}
