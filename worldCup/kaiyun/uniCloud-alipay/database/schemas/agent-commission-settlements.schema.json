{
  "bsonType": "object",
  "required": ["agentId", "amount", "status"],
  "properties": {
    "_id": { "bsonType": "string" },
    "agentId": { "bsonType": "string", "title": "代理用户ID", "foreignKey": "users._id" },
    "agentName": { "bsonType": "string", "title": "代理用户名" },
    "recordIds": { "bsonType": "array", "title": "佣金记录ID列表" },
    "recordCount": { "bsonType": "int", "title": "记录数" },
    "amount": { "bsonType": "double", "title": "结算金额" },
    "periodStart": { "bsonType": "date", "title": "周期开始" },
    "periodEnd": { "bsonType": "date", "title": "周期结束" },
    "status": {
      "bsonType": "string",
      "title": "状态",
      "enum": ["pending", "paid", "cancelled"],
      "default": "pending"
    },
    "createTime": { "bsonType": "date", "title": "创建时间" },
    "operatorId": { "bsonType": "string", "title": "操作人ID" },
    "operatorName": { "bsonType": "string", "title": "操作人名称" },
    "paidTime": { "bsonType": "date", "title": "支付时间" },
    "remark": { "bsonType": "string", "title": "备注" },
    "payVoucher": { "bsonType": "string", "title": "打款凭证" }
  }
}
