{
  "bsonType": "object",
  "required": ["orderId", "type", "status"],
  "properties": {
    "_id": { "bsonType": "string" },
    "type": { "bsonType": "string", "title": "通知类型", "enum": ["bet"], "default": "bet" },
    "orderId": { "bsonType": "string", "title": "订单ID", "foreignKey": "orders._id" },
    "orderNo": { "bsonType": "string", "title": "订单号" },
    "userId": { "bsonType": "string", "title": "用户ID", "foreignKey": "users._id" },
    "userName": { "bsonType": "string", "title": "用户名（短信变量）" },
    "betAmount": { "bsonType": "double", "title": "下注金额" },
    "status": {
      "bsonType": "string",
      "title": "发送状态",
      "enum": ["pending", "sending", "success", "failed", "skipped"],
      "default": "pending"
    },
    "attempts": { "bsonType": "int", "title": "已尝试次数", "default": 0 },
    "nextRetryAt": { "bsonType": "date", "title": "下次重试时间" },
    "lastError": { "bsonType": "string", "title": "最后错误" },
    "createTime": { "bsonType": "date", "title": "创建时间" },
    "updateTime": { "bsonType": "date", "title": "更新时间" }
  }
}
